    <style>
        /* ============================================
           COSMIC ADMIN THEME VARIABLES
        ============================================ */
        :root {
            --sidebar-width: 260px;
            --cosmic-dark: #1a1a3e;
            --cosmic-purple: #2d1b4e;
            --gold-accent: #ffd700;
            --admin-primary: #667eea;
            --admin-secondary: #764ba2;
        }
        
        body {
            padding-top: 60px;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        /* ============================================
           NAVBAR WITH COSMIC THEME
        ============================================ */
        .navbar {
            background: linear-gradient(135deg, #1a1a3e 0%, #2d1b4e 100%) !important;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
            border-bottom: 2px solid rgba(255, 215, 0, 0.2);
        }
        
        .navbar-brand {
            font-weight: 700;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
        }
        
        .navbar-brand:hover {
            transform: scale(1.05);
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.8);
        }
        
        .navbar-text {
            animation: fadeIn 0.6s ease-out;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* ============================================
           SIDEBAR WITH COSMIC ANIMATIONS
        ============================================ */
        .sidebar {
            height: 100vh;
            width: var(--sidebar-width);
            position: fixed;
            top: 0;
            left: 0;
            background: linear-gradient(180deg, #1a1a3e 0%, #2d1b4e 100%);
            padding-top: 60px;
            z-index: 1030;
            transition: transform 0.3s ease-in-out;
            box-shadow: 4px 0 15px rgba(0, 0, 0, 0.3);
            overflow-y: auto;
        }
        
        /* Animated stars in sidebar */
        .sidebar::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-image: 
                radial-gradient(2px 2px at 20px 30px, white, transparent),
                radial-gradient(2px 2px at 60px 70px, white, transparent),
                radial-gradient(1px 1px at 50px 50px, white, transparent),
                radial-gradient(1px 1px at 130px 80px, white, transparent),
                radial-gradient(2px 2px at 90px 10px, white, transparent);
            background-repeat: repeat;
            background-size: 200px 200px;
            animation: stars 50s linear infinite;
            opacity: 0.3;
            pointer-events: none;
        }
        
        @keyframes stars {
            from { transform: translateY(0px); }
            to { transform: translateY(-200px); }
        }
        
        .sidebar a {
            padding: 14px 20px;
            text-decoration: none;
            font-size: 15px;
            color: rgba(255, 255, 255, 0.8);
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
            position: relative;
            margin: 5px 10px;
            border-radius: 10px;
            overflow: hidden;
        }
        
        /* Hover effect with gradient */
        .sidebar a::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background: linear-gradient(to bottom, var(--gold-accent), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .sidebar a:hover::before,
        .sidebar a.active::before {
            opacity: 1;
        }
        
        .sidebar a:hover {
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.3) 0%, rgba(118, 75, 162, 0.3) 100%);
            color: white;
            padding-left: 25px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .sidebar a.active {
            background: linear-gradient(135deg, var(--admin-primary) 0%, var(--admin-secondary) 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.5);
        }
        
        .sidebar a i {
            margin-right: 12px;
            font-size: 18px;
            transition: all 0.3s ease;
            min-width: 20px;
        }
        
        .sidebar a:hover i {
            transform: scale(1.2) rotate(5deg);
            color: var(--gold-accent);
        }
        
        /* Scrollbar styling */
        .sidebar::-webkit-scrollbar {
            width: 8px;
        }
        
        .sidebar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }
        
        .sidebar::-webkit-scrollbar-thumb {
            background: linear-gradient(to bottom, var(--admin-primary), var(--admin-secondary));
            border-radius: 10px;
        }
        
        /* ============================================
           CONTENT AREA
        ============================================ */
        .content {
            margin-left: var(--sidebar-width);
            padding: 30px;
            transition: margin-left 0.3s ease-in-out;
            min-height: calc(100vh - 60px);
        }
        
        /* ============================================
           SIDEBAR TOGGLE BUTTON
        ============================================ */
        .sidebar-toggler {
            display: none;
            background: linear-gradient(135deg, var(--admin-primary) 0%, var(--admin-secondary) 100%);
            border: none;
            transition: all 0.3s ease;
        }
        
        .sidebar-toggler:hover {
            transform: scale(1.1);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.5);
        }
        
        /* ============================================
           LOGOUT BUTTON
        ============================================ */
        .btn-outline-danger {
            transition: all 0.3s ease;
            border: 2px solid #dc3545;
        }
        
        .btn-outline-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
            background: #dc3545;
            border-color: #dc3545;
        }

        /* ============================================
           MOBILE RESPONSIVE STYLES
        ============================================ */
        @media (max-width: 768px) {
            
            /* Sidebar Off-canvas */
            .sidebar {
                transform: translateX(-100%);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            /* Content full width */
            .content {
                margin-left: 0;
                padding: 15px;
            }
            
            /* Show toggle button */
            .sidebar-toggler {
                display: block;
            }
            
            /* Overlay */
            .overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.7);
                z-index: 1029;
                display: none;
                backdrop-filter: blur(5px);
            }
            
            .overlay.active {
                display: block;
                animation: fadeIn 0.3s ease-out;
            }
            
            .navbar-brand {
                font-size: 1.1rem;
            }
        }
        
        /* ============================================
           CARD ENHANCEMENTS FOR ADMIN PAGES
        ============================================ */
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
